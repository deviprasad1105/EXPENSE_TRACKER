# Postgres connection. Local: the LOCAL_FCHUB_DB container (port 5445), user/database dev_dr_expense.
# On Vercel use a hosted Postgres (Neon, Supabase, ...); a plain postgres:// or postgresql:// URL is accepted too
DATABASE_URL=postgresql+psycopg://dev_dr_expense:YOUR_PASSWORD@localhost:5445/dev_dr_expense

# development or production. Production refuses to start with a default/short JWT_SECRET or the default
# admin password, hides /api/docs and sends HSTS
ENVIRONMENT=development

# At least 32 characters. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Created on first start if it does not exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Sign-in protection: block an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILURES wrong passwords,
# and allow at most LOGIN_IP_MAX_ATTEMPTS sign-in attempts per IP address per minute
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20

# Days after creation during which an owner can still edit/delete an expense
EDIT_WINDOW_DAYS=3

# After a username change the user must wait this many days (or ask an admin) to change it again
USERNAME_LOCK_DAYS=15

# Forgot password: max reset emails per window, and how long the link is valid
RESET_MAX_PER_WINDOW=2
RESET_WINDOW_DAYS=15
RESET_TOKEN_MINUTES=60
# Used to build the reset link in the email
FRONTEND_URL=http://localhost:5173

# Daily reminder: if a user has no expense for today by this time, notify them
REMINDER_HOUR=21
REMINDER_MINUTE=0
TIMEZONE=Asia/Kolkata

# Subscriptions: due charges and "renews soon" reminders are processed every hour at this minute
SUBSCRIPTION_JOB_MINUTE=5

# Email for reminders and password resets. With SMTP_HOST empty, emails are saved to MAIL_OUTBOX_DIR as .eml files
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_OUTBOX_DIR=mail_outbox

CORS_ORIGINS=http://localhost:5173

# Vercel only: Vercel Cron sends this as a Bearer token to /api/cron/* (at least 16 random characters)
CRON_SECRET=
